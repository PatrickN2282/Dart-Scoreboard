[Unit]
Description=Dart Scoreboard idle screensaver
After=graphical-session-pre.target dart-scoreboard.service
Wants=dart-scoreboard.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/dart-screensaver
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dart-screensaver

[Install]
WantedBy=default.target
