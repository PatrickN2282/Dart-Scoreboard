[Unit]
Description=Dart Scoreboard Chromium Kiosk
Documentation=file://%h/.local/bin/dart-kiosk
After=dart-scoreboard.service graphical-session-pre.target
Wants=dart-scoreboard.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/dart-kiosk
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dart-kiosk

[Install]
WantedBy=default.target
